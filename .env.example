# Public Supabase project settings
REACT_APP_SUPABASE_URL=https://your-project.supabase.co
REACT_APP_SUPABASE_ANON_KEY=your-anon-key

# Server-only. Required by /api/nub-student-auth for registry lookup and
# first-login account provisioning. Never expose this as a REACT_APP variable.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Optional local-only first-login shortcut. Keep both false in production.
ENABLE_DEV_STUDENT_OTP_BYPASS=false
REACT_APP_ENABLE_DEV_STUDENT_OTP_BYPASS=false
